# ====================================================================
# KthTry — Environment Configuration Template
# ====================================================================
# When Supabase is not configured, KthTry automatically functions
# in 100% persistent local Guest Mode backed by IndexedDB.
#
# To connect to your Supabase cloud backend:
# 1. Create a free project at https://supabase.com
# 2. Run the SQL migrations from /supabase/migrations/
# 3. Copy your project URL and Anon Public Key below
# 4. Rename this file to .env.local

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
